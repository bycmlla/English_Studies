# Copie para .env (que NÃO é versionado) e preencha. Nunca faça commit de valores reais.

NODE_ENV=development
PORT=3000

# Conexão PostgreSQL. Local (docker compose up -d):
DATABASE_URL=postgres://journey:journey@localhost:5432/journey
# true/false. Se vazio: false em desenvolvimento e true em produção (Render).
DATABASE_SSL=false

# Segredo para assinar os tokens (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32+-caracteres
# Validade do token (ex.: 12h, 7d, 30d)
JWT_EXPIRES_IN=7d

# Usuário único. É criado/atualizado automaticamente ao iniciar a API.
# Trocar ADMIN_PASSWORD e reiniciar altera a senha. Mínimo 10 caracteres.
ADMIN_EMAIL=voce@example.com
ADMIN_PASSWORD=troque-esta-senha

# Origens autorizadas a chamar a API, separadas por vírgula, SEM barra no final e SEM caminho.
# GitHub Pages: https://<usuario>.github.io  (o caminho /English_Studies não entra aqui)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://bycmlla.github.io

# Opcionais
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
BCRYPT_ROUNDS=12
RUN_MIGRATIONS_ON_START=true
TRUST_PROXY=1
LOG_LEVEL=info
